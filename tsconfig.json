{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@cloudflare/workers-types", "vite/client", "vitest/globals"]
  },
  "include": ["apps", "shared", "db", "*.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "dist"]
}
