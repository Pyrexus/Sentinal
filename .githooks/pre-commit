#!/bin/sh
if [ -x .tools/gitleaks/gitleaks.exe ]; then
  .tools/gitleaks/gitleaks.exe git --pre-commit --staged --redact --no-banner
elif command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner
else
  echo "gitleaks is not installed. Install it before the release; CI also scans for secrets."
fi
