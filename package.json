{
  "name": "sentinel-digital-safety",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint apps shared db scripts",
    "format": "prettier --write apps shared db docs *.md *.json *.ts",
    "types": "wrangler types --include-runtime false",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "secrets:scan": "gitleaks dir . --redact",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@firebase/app": "0.16.4",
    "@firebase/auth": "1.13.8",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.105.0",
    "drizzle-orm": "0.45.4",
    "framer-motion": "14.7.1",
    "hono": "4.13.14",
    "jose": "6.2.13",
    "lucide-react": "1.63.0",
    "postgres": "3.4.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
