{
  "name": "sentinel-digital-safety",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint apps shared db scripts",
    "format": "prettier --write apps shared db docs *.md *.json *.ts",
    "types": "wrangler types --include-runtime false",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "secrets:scan": "gitleaks dir . --redact",
    "prepare": "node scripts/install-hooks.mjs"
  }
}
